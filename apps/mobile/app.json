{
  "expo": {
    "name": "ELEVEN BR",
    "slug": "eleven-br",
    "version": "0.1.0",
    "icon": "./assets/app/icon.png",
    "splash": {
      "image": "./assets/app/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.eleven.app"
    },
    "android": {
      "package": "br.com.eleven.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app/adaptive-icon.png",
        "backgroundColor": "#075E45"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "ELEVEN BR",
      "lang": "pt-BR"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      ["expo-image-picker", { "photosPermission": "Permitir que o ELEVEN BR selecione sua foto ou escudo.", "cameraPermission": false, "microphonePermission": false }]
    ]
  }
}
