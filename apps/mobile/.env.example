# Optional. Web defaults to its hostname:8011; native uses the Expo LAN host:8011.
# On a physical device, use the computer's LAN address and bind the API to 0.0.0.0.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8011

# Optional public Web origin used in invitations shared from Android/iOS.
# EXPO_PUBLIC_APP_URL=https://app.example.com
