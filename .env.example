APP_ENV=development
DATABASE_URL=postgresql+psycopg://eleven:eleven_local@127.0.0.1:55432/eleven
# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=["http://localhost:8081"]
# Explicit local-only code display. Production rejects true; no external messages are sent.
DEV_VERIFICATION_CODES=false
# Optional local image storage; relative paths are resolved from the repository root.
MEDIA_ROOT=.local/media
# Tests require a SEPARATE database; never use a database containing real data.
TEST_DATABASE_URL=postgresql+psycopg://eleven:eleven_local@127.0.0.1:55432/eleven_test
